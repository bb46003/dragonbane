<section class="tab profession {{tabs.profession.cssClass}}"  action-data="tab"  data-tab="profession">      
    <div class="block">
        <label>{{localize "DoD.characterCreation.choiceProfession"}}
            <a data-tooltip="{{localize "DoD.characterCreation.randomProfession"}}" class="fa-solid fa-dice-d20" data-action="random" data-type="profession" data-dice="{{numbersOfProfession}}"> </a>
        </label>
        <select name="profession">
            {{#each profession}}
                <option 
                    value="{{@index}}" 
                    {{#if (eq @index ../_state.selectedProfessionIndex)}}selected{{/if}}
                >
                    {{this.name}}
                </option>
            {{/each}}
        </select>

        <div class="profession-description">
            <h3>{{selectedProfession.name}}</h3>

            <label>{{localize "DoD.ui.character-sheet.description"}}</label>
            <p>{{{selectedProfession.description}}}</p>
            <div class="flexrow">
            <label>{{localize "DoD.profession.key-attribute"}}</label>
            <label>{{selectedProfession.keyAtr}}</label>
            </div>
            <label>{{localize "DoD.ui.character-sheet.skills"}}</label>
            <ul>
                {{#each selectedProfession.skills}}
                    <li>{{this}}</li>
                {{/each}}
            </ul>
                        <label>{{localize "DoD.ui.character-sheet.abilities"}}</label>
            <ul>
                {{#each selectedKin.abilities}}
                    <li>
                        <label>{{this.name}}</label>
                        <p>{{{this.itemDescriptionHTML}}}</p>
                        <div class="flexrow">
                            <label>{{localize "DoD.ability.wp"}}</label>
                            <p>{{this.system.wp}}</p>
                        </div>
                        {{#if this.system.boons}}
                            <div class="flexrow">
                                <label>{{localize "DoD.ui.dialog.boons"}}</label>
                                <p>{{this.system.boons}}</p>
                            </div>
                        {{/if}}
                    </li>
                {{/each}}
            </ul>
        </div>
    </div>
</section>