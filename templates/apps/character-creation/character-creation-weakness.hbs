<section   class="tab weakness {{tabs.weakness.cssClass}}"  action-data="tab"  data-tab="weakness">    
    <div class="block">
        <label>
            {{localize "DoD.characterCreation.weakness"}}
            {{#if (ne weaknessTable "")}}
            <a data-tooltip="{{localize "DoD.characterCreation.randomWeekness"}}" 
                class="fa-solid fa-dice-d20" 
                data-action="rollTable" 
                data-type="weakness" 
                data-uuid="{{weaknessTable}}"> 
            </a>
            {{/if}}
        </label>
        <prose-mirror
                name="weakness"
                value="{{_state.weakness}}"
                button="true"
                editable="{{editable}}"
                toggled="false">
            {{{weaknessHTML}}}
        </prose-mirror>
    </div>
</section>