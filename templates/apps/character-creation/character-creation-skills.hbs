<section   class="tab skills {{tabs.skills.cssClass}}"  action-data="tab"  data-tab="skills">    
    <div class="block">
        <div class="form-group profession-skills" data-type="profession">
            <label>{{localize "DoD.charactereation.skillsProfession"}}</label>
             <div class="flexcol" >
            {{#each skills.professionSkills as |skill|}}
               <div class="flexcol" name="{{skill}}">
                    <label>
                        {{localize skill}}
                    </label>
                    <input type="checkbox"/>
               </div>
            {{/each}}
              </div>
        </div>
        <div class="form-group other-skills" data-type="other">
            <label>{{localize "DoD.charactereation.skillsOther"}}</label>
             <div class="flexcol">
            {{#each skills.availableSkills as |skill|}}
               <div class="flexcol" name="{{skill}}">
                    <label>
                        {{localize skill}}
                    </label>
                    <input type="checkbox"/>
               </div>
            {{/each}}
              </div>
        </div>
    </div>
</section>